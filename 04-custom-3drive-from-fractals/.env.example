# Скопируй в .env и заполни.
# python-dotenv в bot.py авто-подхватит при запуске.

# Zonetrade auth — externalSignalToken юзера.
ZT_API_KEY=

# WS URL: по дефолту SDK берёт production (wss://zonetrade.app/external-signals).
# Раскомментируй для локального dev:
# ZT_WS_URL=ws://localhost:8087/external-signals

# REST API base: SDK сам выводит из ZT_WS_URL. Указывай явно только
# если WS и REST на разных хостах (типичный local-dev setup):
# ZT_API_BASE_URL=http://localhost:8085

# Пары и TF.
ZT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
ZT_TF=1m

# Окно snapshot'а — сколько закрытых свечей запрашиваем при старте
# чтобы инициализировать state. 200 = ~3 часа на 1m.
ZT_SNAPSHOT_WINDOW_BARS=200
