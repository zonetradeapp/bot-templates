# Скопируй в .env (тот же каталог) и заполни своими значениями.
# python-dotenv в bot.py авто-подхватит при запуске.

# === Обязательно ===
ZT_API_KEY=zt_your_key_here

# === Опциональные параметры стратегии ===
# ZT_SYMBOLS=auto              # auto или пусто — взять из User.signalSymbols (фильтр уведомлений)
# ZT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT   # или явный CSV-override
# ZT_STRATEGY=three-drive-v11    # three-drive-raw (Free) | three-drive-v11 (Starter) | trap-flip (Pro)
# ZT_TIMEFRAMES=1m               # CSV таймфреймов для подписки (1m,5m,15m,1h). Default 1m.
# Sizing — три режима, приоритет сверху-вниз:
#   ZT_RISK_PERCENT=1            # risk-based: убыток на SL = N% balance (правильно для систематики)
#   ZT_AMOUNT_PERCENT=10         # margin-based: N% balance как margin (notional × leverage)
#   ZT_AMOUNT_USD=100            # fallback fixed margin
# ZT_LEVERAGE=5                  # mirror OrderService.php::LEVERAGE
# ZT_MIN_RR=1.5
# ZT_DRY_RUN=0                   # 1 — печатать что бы сделал, не отправлять

# === Куда подключаться (по умолчанию — production) ===
# Production: оставь оба пустыми, SDK возьмёт wss://zonetrade.app/external-signals + REST на том же origin.
# Local dev: укажи оба явно (WS-сервер и backend на разных портах).
# ZT_BASE_URL=ws://localhost:8765/external-signals
# ZT_API_ORDERS_URL=http://localhost:8000
